# ════════════════════════════════════════════════════════════════════════════
# 个人本地开源部署 · 环境变量示例（配合 `docker-compose.personal.yml`）
#
#     cp .env.personal.example .env.personal
#     # 改本机数据源、模型与认证参数；**保持 FIN_EVOLUTION_MODE=observe**
#     docker compose -f docker-compose.yml -f docker-compose.personal.yml --env-file .env.personal up -d postgres redis api
#
# ⚠️ `.env.personal` 里有密钥，**不要提交进任何仓库**（本仓 `.gitignore` 已覆盖 `.env.personal`）。
# ════════════════════════════════════════════════════════════════════════════

# ─── 版本（覆盖文件里镜像已钉死 2.0.0；这两个留着是为了 `docker-compose.yml` 的默认值也对）──
HUNTER_REGISTRY=ghcr.io/agentpit-io
HUNTER_VERSION=2.0.0
FIN_TAG=2.0.0

# ─── 宿主机端口（**全部只绑 127.0.0.1**，见覆盖文件）─────────────────────────
POSTGRES_HOST_PORT=5542
REDIS_HOST_PORT=6579
API_HOST_PORT=8230
WEB_HOST_PORT=3230
OPENCODE_HOST_PORT=4031
PAPER_HOST_PORT=8291
FIN_WORKER_HOST_PORT=8394
TEMPORAL_HOST_PORT=7291
TEMPORAL_UI_HOST_PORT=8292

# ─── 本机访问（单用户）────────────────────────────────────────────────────
# HUNTER_SINGLE_USER=1 时不需要账号密码，前端自动换会话。**只适合本机回环访问。**
# 要让局域网 / 公网访问：置 0，并自己加一层带认证的反代 —— 开着等于谁都能拿到 admin token。
HUNTER_SINGLE_USER=1
HUNTER_LOCAL_USER_EMAIL=local@hunter.local
# 首启向导的初始化口令。**公网上跑必须设**（非空则一律要口令）。
HUNTER_SETUP_TOKEN=

# ─── 数据源 / 模型（个人自己付账）──────────────────────────────────────────
# 大模型：OpenAI 兼容端点。
LLM_PROVIDER=openai_compat
LLM_BASE_URL=
LLM_API_KEY=
LLM_DEFAULT_MODEL=
# 不用 key 看 A 股行情要显式设 akshare（默认留空 = hunter 平台数据源，没 key 时提示去申请）。
DATA_SOURCE_PROVIDER=
# 唯一必填的 hunter-side key（Kronos + 数据 + 工具 + SKILL）。留空也能跑：
# 聊天用你自己的 LLM key；工具在 UI 左下角「解锁全部工具」里填 key。
HUNTER_API_KEY=

# ─── 数据库 / 内部口令 ─────────────────────────────────────────────────────
POSTGRES_USER=hunter
# ⚠️ **要在第一次 `up` 之前设好**：postgres 只在**数据卷为空**时用它初始化。
# 卷建好之后再改这一行，容器会以新口令去连一个仍然记着旧口令的库 → postgres 反复重启
# （连带 temporal / api 起不来）。改口令的正确做法是改库里的角色，不是改这个变量。
# 留空 = compose 默认值 `hunter`（**只绑 127.0.0.1，仅本机可达**，个人部署够用）。
POSTGRES_PASSWORD=
JWT_SECRET=
# ⚠️ **个人部署必须显式设一个非空值**（`openssl rand -hex 32`）。
# api 留空时确实会自动生成一把写进 `hunter_secrets` 卷，但 **`paper` 与 `fin-worker`
# 不挂那个卷**，它们只读这个环境变量 —— 留空时 `paper` 的启动自检直接拒绝启动
# （「HUNTER_INTERNAL_KEY 为空 —— 行情读取凭证缺失，拉行情会一律 401」），
# `fin-worker` 跟着连不上账本。所以六服务那一档可以留空、**fin 栈这一档不行**。
HUNTER_INTERNAL_KEY=
# L06 · **下单执行凭证**（`openssl rand -hex 32`）· **L11 起可选**：
# **不配也行** —— 留空时 `paper` / `fin-worker` 会自动沿用上面的 HUNTER_INTERNAL_KEY
# （老部署平滑升级，一个字不用改就能跑）。想让「下单」用另一把钥匙（与拉行情的凭证
# 分开）再配它，并与上面那把**取不同的值**；配了就用自己的，不会被回退盖掉。
HUNTER_EXEC_KEY=
# 账本运行期角色 fin_paper_rw 的密码（PAPER 模式需要）。生成：openssl rand -hex 24
# 起 paper 前先建角色并设口令（**要把 compose 指向个人版**）：
#     FIN_PAPER_PASSWORD=$(openssl rand -hex 24)   # 填到上面
#     COMPOSE_FILE=docker-compose.yml:docker-compose.personal.yml \
#     COMPOSE_PROJECT_NAME=hunter-personal FIN_PAPER_PASSWORD=… \
#       bash scripts/fin_provision_paper_role.sh
FIN_PAPER_PASSWORD=

# ════════════════════════════════════════════════════════════════════════════
# 记忆系统与受控自进化（`03 §2`）· 四个开关
#
# **一律在 API 服务端读**（`apps/api/app/services/fin/switches.py`，全仓唯一读点），
# 不是前端按钮 —— 前端读开关只认 `GET /api/v1/fin/runtime` 这一个只读接口。
# **L12（2026-10-05）起代码默认取产品定位那一侧**（1 / paper / 1 / 0）= 新装机器默认会学习、
# 会自己用上；下面是部署侧的显式选择。**实盘恒为 0**。三个学习类开关都可在界面上按项目单独关掉。
# ════════════════════════════════════════════════════════════════════════════

# 经验库总开关。0 = memory.query 回空集合、memory.append_evidence 拒绝（HTTP 503）。
# 缺省 / 留空 = 1（开）。
FIN_MEMORY_ENABLED=1

# 进化模式。off | observe | paper。
#   · off      —— 记忆与提案路径整体关闭。
#   · observe  —— 拉行情、复盘、建经验、展示提案；**没有委托发送能力**。
#   · paper    —— 在独立模拟账本里跑现行臂与候选臂（默认选这个）。
#                需要**五个前置依赖全部健康**才进得去：模拟账本 / 市场日历 / 行情快照 /
#                策略决策器 / 验证调度。缺一 → 服务端**自动降到 observe**，并把原因写进
#                `GET /api/v1/fin/runtime` 的 `degraded_reason`（页面显示；**绝不**用历史成交
#                顶替影子结果）。所以选 paper 不会「半生不熟就上」。
# `live` 不在交付范围。
FIN_EVOLUTION_MODE=paper

# 自动生效。1 = 允许「收紧」方向的改进自动应用到模拟盘（放宽 / 混合仍要人工确认）；
# 0 = 任何改动都要人点确认。缺省 / 留空 = 1（开）。**只改模拟盘策略参数，不下真单**。
FIN_AUTO_APPLY=1

# 实盘订单出口。**本项目没有实盘出口**，必须为 0（唯一的硬开关，非 0 → 服务端拒绝请求）。
FIN_LIVE_ORDER_ENABLED=0

# 收盘后复核（复盘）工作流 `fin.review` 的触发延迟（分钟）：
# 时点 = 该市场**时段末点** + 这个值。可配（默认 30）；读不到 / 非数字 / 负数一律回落 30 并在日志写明。
# ⚠️ A 股的「时段末点 + 30」与自身的 close 时点同分，真部署时把这里调到 45~60 可错开报告生成。
FIN_REVIEW_DELAY_MINUTES=30

# ════════════════════════════════════════════════════════════════════════════
# paper 模式需要哪些依赖健康（`03 §2` 的五个探针，缺一即降级 observe）
#
#   1. 模拟账本      GET {PAPER_BASE_URL}/healthz → ok && mode=PAPER && ledger_db
#   2. 市场日历      fin_market_calendar 里今天起至少有一个 is_trading 的交易日
#   3. 行情快照      fin_snapshot 近 90 天至少有一行
#   4. 策略决策器    fin_param 里至少有一个项目配了 strategies
#   5. 验证调度      fin_job 里至少有一次 strategy_run / trading_point 执行记录
#
# 这五项都随正常使用自然满足（跑过一次时点、有过一次快照即可）。
# 在本机第一次起 `--profile paper` 之前，通常 3/4/5 都还没有 → 起来后 `/v1/fin/runtime`
# 会报 observe + 原因，这是**按设计**，不是故障。
# ════════════════════════════════════════════════════════════════════════════
PAPER_BASE_URL=http://paper:8000
PAPER_QUOTE_URL=http://api:8000
# 时点调度 / 复核调度总开关（排障时置 0）。
FIN_SCHEDULES_ENABLED=1
