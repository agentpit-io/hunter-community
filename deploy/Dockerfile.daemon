# HunterCode · AtomCode 发行版 · daemon 镜像
#
# 构建上下文是**仓库根**：
#     docker build -f deploy/Dockerfile.daemon -t hca-daemon:dev .
#
# 三段：
#   1. atomcode-fetch —— 按 pins.lock 从 npm 取官方二进制，**两道 sha256 都校验**
#   2. pydeps         —— uv 建 venv，装 9 个 MCP 的依赖（akshare 会拉进 pandas 一大家子）
#   3. runtime        —— 只带走前两段的产物 + 工作区模板 + 技能 + hook，非 root 跑
#
# 校验值来自 pins.lock（M0 实测）。**校验不过就构建失败**，不给"跳过校验"的口子 ——
# 一个装错版本的二进制会让后面所有实测数字失去意义。
# 改版本时 pins.lock 与这里的 ARG 一起改，两边对不上会在第 1 段炸掉。

# ── 1. 取二进制 ──────────────────────────────────────────────────────────────
# ── 国内网络（M4 · TP-08「镜像与 npm 源可配置」）─────────────────────────────
# BASE_IMAGE_PREFIX  基础镜像前缀（要带结尾斜杠），例 docker.m.daocloud.io/
# NPM_REGISTRY       取 AtomCode 官方二进制用的 npm 源
#                    ⚠ 换源之后 sha256 校验照旧 —— 镜像源上的包不一致会**直接构建失败**，
#                      这是有意的：宁可装不上，也不要装上一个来路不明的二进制。
# PIP_INDEX_URL      uv / pip 源，例 https://pypi.tuna.tsinghua.edu.cn/simple
ARG BASE_IMAGE_PREFIX=""

FROM ${BASE_IMAGE_PREFIX}node:22-bookworm-slim AS atomcode-fetch

# pins.lock [atomcode]：version 5.1.0 / npm_version 5.1.0-linux-x64
ARG NPM_REGISTRY=""
ARG ATOMCODE_NPM_PACKAGE="@atomgit.com/atomcode"
ARG ATOMCODE_NPM_VERSION="5.1.0-linux-x64"
# pins.lock npm_tgz_sha256（对 npm 包）
ARG ATOMCODE_TGZ_SHA256="220ea8d7b31c4482b7235fa251d266be080f8fedbf6d89d44f4cf642bfc872f5"
# pins.lock [atomcode.binaries.linux-x64].sha256 —— 主校验，与上游 latest.json 一致
ARG ATOMCODE_BIN_SHA256="40d86fa3e31980dbcdc8a6e5707c822f3953284ff76b31523789ca19988c8763"

WORKDIR /fetch
RUN set -eux; \
    if [ -n "${NPM_REGISTRY}" ]; then npm config set registry "${NPM_REGISTRY}"; fi; \
    npm pack "${ATOMCODE_NPM_PACKAGE}@${ATOMCODE_NPM_VERSION}" >/dev/null; \
    tgz="$(ls ./*.tgz)"; \
    echo "${ATOMCODE_TGZ_SHA256}  ${tgz}" | sha256sum -c -; \
    tar xzf "${tgz}" package/bin/atomcode; \
    echo "${ATOMCODE_BIN_SHA256}  package/bin/atomcode" | sha256sum -c -; \
    mkdir -p /out; \
    install -m 0755 package/bin/atomcode /out/atomcode; \
    /out/atomcode --version

# ── 2. Python 依赖 ───────────────────────────────────────────────────────────
FROM ${BASE_IMAGE_PREFIX}python:3.12-slim-bookworm AS pydeps

# uv 而不是 venv + pip：M0 在测试机上实测 uv 装 akshare-mcp 6.56 秒，
# 而且不需要 python3-venv 这个 Debian 单独包。版本钉死，不让构建随 PyPI 漂。
ARG UV_VERSION="0.12.17"
# pip 与 uv 都认这两个环境变量（uv 优先 UV_INDEX_URL，回落 PIP_INDEX_URL）
ARG PIP_INDEX_URL=""
ENV PIP_INDEX_URL=${PIP_INDEX_URL}
ENV UV_INDEX_URL=${PIP_INDEX_URL}

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN set -eux; \
    apt-get update; \
    # akshare 的依赖里有需要编译的（视 wheel 覆盖情况而定），给上 gcc；
    # 这一段是构建阶段，不会进最终镜像
    apt-get install -y --no-install-recommends build-essential; \
    rm -rf /var/lib/apt/lists/*; \
    pip install "uv==${UV_VERSION}"

# 三个上了 PyPI 的 MCP 从**仓库内源码**装，不从 PyPI 拉 ——
# 这样镜像里跑的就是本仓库这一版，和 tools/*-mcp/ 逐字节对应，不会出现
# "改了源码但镜像里还是旧版" 这种只有真跑才发现的偏差。
COPY tools/akshare-mcp    /src/akshare-mcp
COPY tools/kronos-mcp     /src/kronos-mcp
COPY tools/truesource-mcp /src/truesource-mcp

# 两个 venv，不是一个。
#
# 起因是 M1 构建时真跑出来的错：六个 hunter 系 MCP 在 mcp 2.x 下**起不来**，
# 报 `AttributeError: 'Server' object has no attribute 'list_tools'`
# （/mcp/status 上的表现是 "MCP server closed stdout"，看不出根因）。
# `mcp.server.Server` 这个类在 2.x 里还在、import 得到，但 1.x 那套
# `@server.list_tools()` 装饰器 API 被移掉了 —— 只验 import 会漏掉这个，
# 所以下面的自检**实例化 Server 并检查装饰器是否存在**。
#
#   /opt/hca/venv         mcp 2.x  —— akshare / kronos / truesource（MCPServer 新 API）
#   /opt/hca/venv-hunter  mcp 1.x  —— uzi / watchlist / portfolio / screener /
#                                     hunter_cap / hunter_user（低阶 Server + 装饰器）
#
# 这六个是从 hunter-community 一次性导入的、写给 opencode 的脚本。把它们升到 2.x
# 属于改导入来的业务代码，不在 M1 范围（记进待办池）；两个 venv 各自干净，代价只有
# 几十 MB。
RUN set -eux; \
    uv venv /opt/hca/venv; \
    uv pip install --python /opt/hca/venv/bin/python \
        /src/akshare-mcp /src/kronos-mcp /src/truesource-mcp; \
    uv venv /opt/hca/venv-hunter; \
    uv pip install --python /opt/hca/venv-hunter/bin/python "mcp>=1.30,<2" "httpx>=0.27.0"; \
    /opt/hca/venv/bin/python -c "\
import importlib;\
[importlib.import_module(m) for m in ('mcp.server.mcpserver','httpx','akshare')];\
import akshare, mcp;\
print('venv 自检：akshare', akshare.__version__)"; \
    /opt/hca/venv-hunter/bin/python -c "\
from mcp.server import Server;\
from mcp.server.stdio import stdio_server;\
from mcp.types import Tool, TextContent;\
s = Server('selfcheck');\
assert hasattr(s, 'list_tools') and hasattr(s, 'call_tool'), '这版 mcp 没有 1.x 的装饰器 API';\
print('venv-hunter 自检：Server 装饰器 API 在')"

# ── 3. 运行时 ────────────────────────────────────────────────────────────────
FROM ${BASE_IMAGE_PREFIX}python:3.12-slim-bookworm AS runtime

LABEL org.opencontainers.image.title="hca-daemon" \
      org.opencontainers.image.description="HunterCode · AtomCode 发行版 daemon（AtomCode 5.1.0 + 投研 MCP / 技能 / hook）" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://gitcode.com/agentpit-io/huntercode-atomcode" \
      hca.component="daemon"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/hca/bin:/opt/hca/venv/bin:${PATH}" \
    ATOMCODE_HOME=/data/atomcode \
    HCA_WORKSPACE=/workspace \
    HCA_TEMPLATE_DIR=/opt/hca/workspace-template \
    HCA_TOKEN_DIR=/run/hca \
    HCA_DAEMON_PORT=13456 \
    HCA_DAEMON_INTERNAL_PORT=13457 \
    HCA_PYTHON=/opt/hca/venv/bin/python \
    # ── 领域改造：关掉编码向的开关（M2 · docs/coding-bias-analysis.md 逐条给了依据）──
    #
    # 每一个都同时控制**系统提示里的那一段**和**对应工具挂不挂载** —— 上游把两者
    # 钉在同一个 helper 上，就是为了不出现"提示让你用一个没挂载的工具"。
    # 所以关掉 = 既省 token，又不会让模型去调一个不存在的工具。
    #
    # ATOMCODE_VERIFY=off       关掉"改完代码要跑一次校验"的强制续跑（discipline/verify.rs）。
    #                           /live 是 interactive=true、默认本来就抑制；显式置 off 是为了
    #                           /chat 与将来别的入口也一致。
    # ATOMCODE_TODO=0           关掉 todowrite 工具 + `## TASK TRACKING` 段。那一段的措辞
    #                           （"add retry to fetch_user"）纯粹是编码语境。
    # ATOMCODE_SUBAGENT=0       关掉 task / team 工具 + `## DELEGATING WITH task` / `## TEAM AGENT`
    #                           两段。子代理要么改文件要么扫代码，投研用不上。
    # ATOMCODE_MEMORY_TOOL=0    关掉 memory 工具 + `## MEMORY` 段（那段直接提 AGENTS.md）。
    #                           要记住的东西写进 theses/。
    # ATOMCODE_REQUEST_USER_INPUT=0
    #                           关掉 request_user_input + `## ASKING THE USER` 段。headless 下
    #                           一个没人应答的结构化提问会把整轮挂住；改成在正文里用自然语言问。
    # ATOMCODE_TURN_MAX_ROUNDS=30
    #                           一轮最多 30 个回合的防跑飞保险丝。M1 实测最长的正常用例是 18
    #                           回合，而失控那次（MCP 掉了、模型改用 bash 抓数据）一轮烧掉约
    #                           102 万 token。30 留足余量又封住了失控。
    ATOMCODE_VERIFY=off \
    ATOMCODE_TODO=0 \
    ATOMCODE_SUBAGENT=0 \
    ATOMCODE_MEMORY_TOOL=0 \
    ATOMCODE_REQUEST_USER_INPUT=0 \
    ATOMCODE_TURN_MAX_ROUNDS=30

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        # daemon 恒绑 127.0.0.1（5.1.0 无 --host），socat 把它转到容器网络上
        socat \
        # AtomCode 内置 bash 工具要用；python:slim 自带，这里显式列出以免基础镜像瘦身后失效
        bash \
        # 模型写脚本/查数据常用；比事后 apt 装省事
        less \
        ; \
    rm -rf /var/lib/apt/lists/*; \
    # 非 root：uid/gid 固定 10001，便于宿主给数据卷对权限
    groupadd -g 10001 hca; \
    useradd -u 10001 -g 10001 -m -d /home/hca -s /bin/bash hca

COPY --from=atomcode-fetch /out/atomcode /usr/local/bin/atomcode
COPY --from=pydeps         /opt/hca/venv        /opt/hca/venv
COPY --from=pydeps         /opt/hca/venv-hunter /opt/hca/venv-hunter

# hunter 系 MCP（薄代理，反调 HunterCode 后端 / fin-worker）
# hca_size_guard.py 与它们同目录，所以 stdio 启动时同目录 import 得到（待办池 P0-11）
COPY tools/opencode-mcp/hca_size_guard.py         /opt/hca/mcp/hca_size_guard.py
COPY tools/opencode-mcp/hca_pack_mcp.py           /opt/hca/mcp/hca_pack_mcp.py
COPY tools/opencode-mcp/hca_news_date.py          /opt/hca/mcp/hca_news_date.py
COPY tools/opencode-mcp/uzi_mcp.py                /opt/hca/mcp/uzi_mcp.py
COPY tools/opencode-mcp/watchlist_mcp.py          /opt/hca/mcp/watchlist_mcp.py
COPY tools/opencode-mcp/portfolio_mcp.py          /opt/hca/mcp/portfolio_mcp.py
COPY tools/opencode-mcp/screener_mcp.py           /opt/hca/mcp/screener_mcp.py
COPY tools/opencode-mcp/hunter_capability_mcp.py  /opt/hca/mcp/hunter_capability_mcp.py
COPY tools/opencode-mcp/hunter_user_mcp.py        /opt/hca/mcp/hunter_user_mcp.py
COPY tools/opencode-mcp/runtime_mcp.py            /opt/hca/mcp/runtime_mcp.py
COPY tools/opencode-mcp/fin_memory_mcp.py         /opt/hca/mcp/fin_memory_mcp.py

# 工作区模板（含 .atomcode.md / .mcp.json / .hooks.json / .hooks/ / .atomcode/skills/）
COPY distro/workspace-template /opt/hca/workspace-template
COPY distro/mcp-tools.json     /opt/hca/mcp-tools.json
# 可整体替换内置编码人设的领域人设（**只有 fork 二进制认**，见 docs/fork-patches.md）。
# 官方二进制上这个目录躺着不用 —— 烤进镜像是为了两种二进制共用同一份镜像层，
# 换二进制（deploy/Dockerfile.daemon-fork 叠一层）时不必重建下面所有层。
COPY distro/personas           /opt/hca/personas

# 启动脚本与运维工具
COPY deploy/daemon/entrypoint.sh   /opt/hca/bin/entrypoint.sh
COPY deploy/daemon/hca-init.py     /opt/hca/bin/hca-init.py
COPY deploy/tools/dump_mcp_tools.py /opt/hca/tools/dump_mcp_tools.py
# P0-11 的前后对照探针（零 token，量一次宽表返回会不会超过内核的 16 KB 阈值）
COPY tools/stability/size_guard_probe.py /opt/hca/tools/size_guard_probe.py
# A/B 评测的 HCA 侧探针（M2）。打进镜像而不是评测时 docker cp —— 报告里的
# 每个数字都要能对应到一个确定版本的采集脚本。
COPY tools/eval/eval_atomcode.py   /opt/hca/tools/eval_atomcode.py

RUN set -eux; \
    chmod 0755 /opt/hca/bin/entrypoint.sh /opt/hca/bin/hca-init.py /opt/hca/tools/*.py; \
    chmod 0755 /opt/hca/workspace-template/.hooks/*.sh /opt/hca/workspace-template/.hooks/*.py; \
    # 这三个目录会被数据卷盖住；先建好并 chown，卷初始化时会继承这里的属主，
    # 否则非 root 的 hca 写不进去（Docker 默认给新卷 root:root）
    mkdir -p /data/atomcode /workspace /run/hca; \
    chown -R hca:hca /data /workspace /run/hca /opt/hca; \
    # 构建期自检：二进制能跑、技能真的拷进来了
    atomcode --version; \
    test -f /opt/hca/workspace-template/.atomcode/skills/uzi/SKILL.md; \
    ls /opt/hca/workspace-template/.atomcode/skills | wc -l

USER hca
WORKDIR /workspace

EXPOSE 13456

# /health 是 daemon 唯一的公开路由（不需要 token）。走 $HCA_DAEMON_PORT，
# 也就是 socat 那一层 —— 这样健康检查同时覆盖了 daemon 和转发，
# 只测回环端口会漏掉"daemon 活着但容器网络上连不上"这种情况。
HEALTHCHECK --interval=15s --timeout=5s --start-period=120s --retries=5 \
    CMD curl -fsS "http://127.0.0.1:${HCA_DAEMON_PORT}/health" >/dev/null || exit 1

ENTRYPOINT ["/opt/hca/bin/entrypoint.sh"]
