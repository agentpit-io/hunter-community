# Hunter Community Edition · P1 skeleton env
# Copy to .env before `docker compose up`.
#
# All values below have working defaults for local dev.
# For production: rotate JWT_SECRET, set strong POSTGRES_PASSWORD, add your LLM_API_KEY.

# ─── Boot mode ─────────────────────────────────────────────
# When 1, skip background schedulers (collector, signal_monitor, gm_alerts,
# backtest, stocks_catalog seed) that need external creds like LLM_API_KEY.
# DDL is always run · table-backed features (auth · watchlist · settings) work
# regardless. Set to 0 once you've filled in LLM_API_KEY + HUNTER_SAAS_DATA_KEY
# (or configured local akshare/yfinance providers) to enable the full features.
HUNTER_MINIMAL_BOOT=1

# ─── Host port mapping ──────────────────────────────────────
# We use non-standard host ports to avoid conflict with hermes / VLLM / opencode
# on shared machines like fin-r1.
WEB_HOST_PORT=3100
API_HOST_PORT=8100
POSTGRES_HOST_PORT=5442
REDIS_HOST_PORT=6479
# OPENCODE_HOST_PORT=3921

# ─── Postgres ──────────────────────────────────────────────
POSTGRES_USER=hunter
POSTGRES_PASSWORD=hunter
POSTGRES_DB=hunter

# ─── Local Auth (P3) ───────────────────────────────────────
# CRITICAL · rotate before exposing to internet
# Generate: openssl rand -base64 48
JWT_SECRET=change-me-in-production-please
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# ─── Single-user mode (ON by default) ──────────────────────
# It's your own machine, so there is no login screen: the frontend silently
# gets a session for one built-in local account and you land straight in the app.
#
# ⚠️ Set to 0 the moment this instance is reachable by anyone but you.
#    With it on, ANY request to /api/auth/local-session gets an admin token —
#    no reverse proxy in front can tell the difference.
#    Turning it off brings back /login + /register (first account = admin).
HUNTER_SINGLE_USER=1
# HUNTER_LOCAL_USER_EMAIL=local@hunter.local

# Registration policy (only matters when HUNTER_SINGLE_USER=0): open · invite · closed
#   open   = anyone can register (first user auto-admin)
#   invite = requires code from admin (first user still auto-admin)
#   closed = registration disabled entirely
REGISTRATION_MODE=open

# Comma-separated admin email allowlist (used by /api/backtest/run guard until P4)
# HUNTER_ADMIN_EMAILS=admin@example.com,ops@example.com

# ─── Hunter platform key · unlocks the tools & SKILLs ──────
# Plain chat works with just your own LLM_API_KEY below. The **tools and SKILLs**
# in the left sidebar (行情速查 · K线 · 财报 · 关键新闻 · UZI 深度分析 ·
# Kronos 走势预测) execute on Hunter's servers and need a key issued by us:
#
#     https://hunter.agentpit.io/dev/api-keys      free · ~30 seconds
#
# Two ways to supply it — pick either:
#   1. paste it here, then `docker compose up -d` (survives container recreation)
#   2. leave it empty and paste it in the UI: chat page → bottom-left
#      「解锁全部工具」 → takes effect immediately, no restart
# HUNTER_API_KEY=hunt_tools_xxxxxxxxxxxxxxxx

# ─── Pluggable providers (P4) ──────────────────────────────
# Data source: hunter · saas · akshare (A-shares · no key) · yfinance (US/HK)
# Leave EMPTY and it auto-picks: "hunter" when a key is configured above,
# otherwise "akshare". Set it explicitly only to override that choice.
DATA_SOURCE_PROVIDER=
# HUNTER_SAAS_DATA_URL=https://finance-data.agentpit.io
# HUNTER_SAAS_DATA_KEY=hunt_data_xxxxxxxxxxxxxxxx

# LLM: openai_compat · anthropic · saas_gemini
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_DEFAULT_MODEL=gpt-4o-mini

# Forecast: noop (default · Kronos disabled) · kronos_local · kronos_saas
FORECAST_PROVIDER=noop
# KRONOS_LOCAL_URL=http://kronos:8188
# HUNTER_SAAS_KRONOS_URL=https://kronos.hermes.agentpit.io
# HUNTER_SAAS_KRONOS_KEY=hunt_kron_xxxxxxxxxxxxxxxx

# ─── Frontend ──────────────────────────────────────────────
# Public URL the browser will hit to reach the API. Adjust when hosting behind a domain.
# 浏览器访问 API 的地址。前端代码读的是 NEXT_PUBLIC_API_URL
# （app/login/page.tsx 等 6 处），不是 _BASE —— 名字写错会让前端拿到空串，
# 于是去请求 web 自己的 /api/auth/login，登录页报"网络错误"。
#
# 留空 = 走同源相对路径 /api/*，适合前面有 nginx 反代的部署（演示站就是这样）。
# 直接 docker compose up（没有反代）时必须填成下面这个绝对地址。
# 注意 NEXT_PUBLIC_* 是**构建期**烘进前端产物的，改完要重新 build 才生效。
NEXT_PUBLIC_API_URL=http://localhost:8100

# ─── OpenCode chat engine (ghcr.io/agentpit-io/hunter-opencode) ──
# The huntercode fork is published as a Docker image · hunter-community
# consumes it via the opencode service in docker-compose.yml
OPENCODE_TAG=latest
OPENCODE_USER=opencode
OPENCODE_PASS=changeme
# Shared secret with the api container for internal MCP callbacks
# Generate: openssl rand -hex 20
HUNTER_INTERNAL_KEY=
# Budget plugin (per-request LLM token cap) · disabled by default in Community
HUNTER_BUDGET_ENABLED=false
