# 通义 qwen-max · 阿里 dashscope · ⏳ 待评测(2026-08-15)
# P0 与 DeepSeek 并列 · 兼容好 · 用户基数大

LLM_PROVIDER=openai_compat
# 关键: compatible-mode 后缀不能漏 · dashscope 原生 API 用 /api/v1 不兼容 OpenAI
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=qwen-max
# 可选 model:
#   qwen-max               · 旗舰 · 贵但稳
#   qwen3-235b-a22b-instruct-2507  · 新一代 235B · 效果好
#   qwen-plus              · 中档
#   qwen-turbo             · 便宜快
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx      # 去 https://dashscope.console.aliyun.com/apiKey 拿

# qwen 相对宽容 · auto = 只 Gemini 通道走 shim · 其他不走
# 若某 case 400 参数错 · 改成 =1 强制走 shim
LLM_SCHEMA_SANITIZE=auto

# 预期踩坑(未实测 · 从社区反馈):
# · qwen-max tool_call 触发比 DeepSeek 稍保守 · 可能需要 prompt 更明确
# · 中文能力顶尖 · 报告可读性可能优于 DeepSeek
# · pricing 比 DeepSeek 高 3-5 倍
