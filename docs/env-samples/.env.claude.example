# Claude Sonnet 4.6 · ⏳ 待评测(2026-08-15)
# P2 · 海外用户首选 · tool_call 最稳定但最贵

LLM_PROVIDER=anthropic                                # 关键: 不是 openai_compat · 走 anthropic 原生
LLM_BASE_URL=https://api.anthropic.com                # 无 /v1 后缀

LLM_DEFAULT_MODEL=claude-sonnet-4-6
# 可选 model:
#   claude-opus-4-7          · 最强 · 贵
#   claude-sonnet-4-6        · 平衡 · 推荐(与 haiku-4-5 差异不大且更强)
#   claude-haiku-4-5-20251001 · 便宜快
LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # https://console.anthropic.com/settings/keys

# Anthropic 不需要 schema sanitize(schema 本来就不是 OpenAI 那套)
LLM_SCHEMA_SANITIZE=0

# 预期特性(未实测但基于 Claude 一般表现):
# · tool_call schema Anthropic 原生 · 可能需要 hunter-mcp-context / hunter-guard plugin
#   针对 anthropic provider 有特殊处理 · 若报 "tools 不认识" 先看 opencode 侧适配
# · 4.6 应对 4-8 轮 tool 循环极稳 · 深度分析报告可读性优
# · pricing ~$0.003/1K input · $0.015/1K output · 比 DeepSeek 贵 30-100 倍
# · 深度分析单条 ~$0.05-$0.15
# · CN 用户可能需要 API 代理(claude.ai 直连大陆有限制)
