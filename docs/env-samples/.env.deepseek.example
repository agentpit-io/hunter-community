# DeepSeek v4 pro · 已实测 ✅ P0 推荐(2026-08-15)
# 详见 ../results/2026-08-15_deepseek_v4pro_对比分析.md
#
# 用法: 把这几行 merge 到 $HUNTER_COMMUNITY/.env 里的 LLM_* 段
#       或直接替换现有 LLM_* 行 · 然后 docker compose up -d --force-recreate opencode llm-shim

LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_DEFAULT_MODEL=deepseek-v4-pro
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx      # 去 https://platform.deepseek.com/api_keys 拿

# DeepSeek 必开(否则 parameters: null 400)· 见 06 §6.4
LLM_SCHEMA_SANITIZE=1

# reasoning 型模型 · max_tokens 建议 8192+(否则 reasoning 吃完 · content 空)
# 这个 var 若 hunter-community 支持 · 可加:
# LLM_MAX_TOKENS=8192

# 已知踩坑:
# · shim SSL EOF 偶发但不阻塞(retry 会兜住)· 见 shim.py Handler._proxy
# · reasoning tokens 常态 0-1000 · 深度分析(uzi_stock_deep_analysis)可达 5000+
# · 深度分析典型 3-5 分钟 · SSE 超时要放到 600s(BFF 已配)
