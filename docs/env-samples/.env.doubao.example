# 豆包(火山引擎)· ⏳ 待评测(2026-08-15)
# P1 · 覆盖头条系用户 · 配置最绕(endpoint_id 而非 model 名)

LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ⚠️ 关键陷阱:LLM_DEFAULT_MODEL 填的是 endpoint_id · 不是 model 名!
# 需要去 https://console.volcengine.com/ark/region:ark+cn-beijing/endpoint
# 创建一个 endpoint(选一个 doubao model · 如 doubao-pro-32k)· 拿返回的 ep-xxxx-xxxx
LLM_DEFAULT_MODEL=ep-xxxxxxxxxxxx-xxxxx              # 你的 endpoint_id · 不是 doubao-pro-32k!

LLM_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx    # 火山引擎 API Key(volcengine.com IAM)

# 豆包相对宽容 · 但个别 case 可能触发 schema issue
LLM_SCHEMA_SANITIZE=auto

# 预期踩坑(未实测):
# · endpoint_id vs model 名混淆是最常见错法 · 报 "model not found" 立刻查
# · 豆包 tool_call 支持不同 model 差异大 · 建议先测 doubao-pro-32k(标准 tool 支持)· 别用 lite 版
# · 有 endpoint 计费 · 每个 endpoint 独立计费单元 · 别开一堆 endpoint 又不删

# 若不想搞 endpoint · 可试 volcengine 的 pathwaystechnology gateway:
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_DEFAULT_MODEL=doubao-pro-32k-241215  # 直接用模型 · 部分场景可能不支持
