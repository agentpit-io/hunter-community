# GPT-4o · ⏳ 待评测(2026-08-15)
# P2 · 海外用户备选 · 官方 OpenAI 是所有 OpenAI-compat 兼容的基线

LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.openai.com/v1
LLM_DEFAULT_MODEL=gpt-4o                              # 或 gpt-4o-mini(便宜快 · 但 tool 稳定性差)
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx      # https://platform.openai.com/api-keys

# OpenAI 原生 OpenAPI schema · 不需要 sanitize
LLM_SCHEMA_SANITIZE=0

# 预期特性(未实测):
# · gpt-4o tool_call 是行业标杆 · 应无兼容问题
# · gpt-4o-mini 便宜但 5-6 轮循环稳定性差 · 深度分析可能中途 lose track
# · pricing gpt-4o ~$0.0025/1K input · $0.010/1K output(比 DeepSeek 贵 5-10 倍)
# · pricing gpt-4o-mini ~$0.00015/1K input · $0.0006/1K output(比 DeepSeek 便宜)
# · CN 用户直连限流严重 · 建议走 OneAPI 中转:
#     LLM_BASE_URL=https://<你的-oneapi-host>/v1
#     LLM_DEFAULT_MODEL=gpt-4o    # OneAPI 会路由到官方
#     LLM_SCHEMA_SANITIZE=1        # 走 OneAPI 通道有时 schema 处理不一致 · 保险开
